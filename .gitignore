# Python desktop application (PyQt5), packaged with PyInstaller.

# Byte-compiled files and packaging metadata
__pycache__/
*.py[cod]
*.egg-info/

# Toolchain caches and dependencies
.venv/
venv/

# Test and coverage output
.pytest_cache/
.coverage
htmlcov/

# Build output
build/
dist/
*.spec

# The version stamp `build.sh` writes for the packaged binary
_version.py

# Logs
*.log
